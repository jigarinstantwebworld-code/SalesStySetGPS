<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#EDE6E6"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp">

    <!-- Stop Letter Circle -->
    <TextView
        android:id="@+id/tvStopLetter"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_background"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <!-- Stop Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Store Name"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStopTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:15 AM - 10:30 AM"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

        <TextView
            android:id="@+id/tvStopDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 min"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/purple_500" />

        <TextView
            android:id="@+id/tvStopAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="123 Main St"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>