            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.CreateLeadActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ActivityAttendance"
            android:exported="false" />
        <activity
            android:name=".ui.SyncTestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ApiActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LeadActivity"
            android:exported="false" />
        <activity
            android:name=".VisitDetailActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity2"
            android:exported="true" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" /> <!-- Google Play Services version (already there) -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" /> <!-- Add these for Calendar API -->
        <!-- <meta-data -->
        <!-- android:name="com.google.android.gms.auth.api.signin" -->
        <!-- android:value="@integer/google_play_services_version" /> -->
        <service
            android:name=".location.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" /> <!-- Calendar Sync Service -->
        <!-- <service -->
        <!-- android:name=".services.CalendarSyncService" -->
        <!-- android:exported="false" /> -->
        <!-- &lt;!&ndash; WorkManager Provider &ndash;&gt; -->
        <!-- <provider -->
        <!-- android:name="androidx.work.impl.WorkManagerInitializer" -->
        <!-- android:authorities="${applicationId}.workmanager-init" -->
        <!-- android:exported="false" -->
        <!-- tools:node="remove" /> -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"></activity>
        <activity
            android:name=".ui.PlacesActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>